# Same-origin dev: leave VITE_API_BASE empty and rely on Vite's proxy
# (see vite.config.ts → server.proxy). The browser sees one origin, so
# __Host- cookies and SameSite=Strict work without any CORS config.
VITE_API_BASE=

# Separate-origin dev: point the SPA directly at the backend. Make sure
# the backend's CORS config (src/config/cors.php) allows this origin
# with `credentials: true`.
#VITE_API_BASE=http://localhost:8080

# Used by vite.config.ts's proxy target when running same-origin.
APP_BACKEND_ORIGIN=http://localhost:8080
