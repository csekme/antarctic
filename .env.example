# DB engine: `mariadb` vagy `postgresql`. A docker-compose.yml a
# `./docker/${DATABASE}/Dockerfile`-t buildeli, és az alábbi DATABASE_DATADIR
# alapján mountolja a perzisztens kötetet.
DATABASE=mariadb
DATABASE_HOST=localhost
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_ROOT_PASSWORD=root_password
DATABASE_NAME=database_name

# MariaDB esetén: 3306 + /var/lib/mysql
DATABASE_PORT=3306
DATABASE_DATADIR=/var/lib/mysql

# PostgreSQL esetén cseréld a fenti két sort:
# DATABASE_PORT=5432
# DATABASE_DATADIR=/var/lib/postgresql/data
