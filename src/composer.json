{
    "name": "csekme/antarctic",
    "description": "SPA-native PHP 8.4 backend framework with RS256 JWT, PSR-7/15 pipeline, php-di, doctrine/migrations, OpenAPI, rate limiting, and a production Docker stack.",
    "type": "project",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/csekme/antarctic",
    "keywords": [
        "php84",
        "framework",
        "jwt",
        "psr-7",
        "psr-15",
        "spa",
        "openapi",
        "rate-limit",
        "docker"
    ],
    "authors": [
        {
            "name": "Krisztián Csekme",
            "email": "csekme.krisztian@outlook.com",
            "homepage": "https://github.com/csekme"
        }
    ],
    "support": {
        "issues": "https://github.com/csekme/antarctic/issues",
        "source": "https://github.com/csekme/antarctic"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "Application/",
            "Framework\\": "Framework/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "twig/twig": "^3.0",
        "phpmailer/phpmailer": "^6.9",
        "ext-pdo": "*",
        "robthree/twofactorauth": "^3.0",
        "symfony/polyfill-iconv": "^1.31",
        "bacon/bacon-qr-code": "^3.0",
        "monolog/monolog": "^3.5",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/clock": "^1.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "laminas/laminas-httphandlerrunner": "^2.10",
        "lcobucci/jwt": "^5.3",
        "php-di/php-di": "^7.0",
        "doctrine/migrations": "^3.7",
        "symfony/validator": "^7.1",
        "zircote/swagger-php": "^4.10",
        "predis/predis": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M"
    }
}
