DATABASE=mariadb or postgresql
# Container-belül a docker-compose service-nevét használd (`database`),
# host-CLI-ből (pl. doctrine migrate) `127.0.0.1`-et a port-forward-on át.
# `localhost` MySQL/MariaDB-vel Unix-socket-be vált át, ami nem létezik
# a konténerben — mindig service-nevet vagy 127.0.0.1-et, sose `localhost`-ot.
DATABASE_HOST=database
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_ROOT_PASSWORD=root_password
DATABASE_NAME=database_name
DATABASE_PORT=3306

# Runtime mode: production | local. APP_ENV=local lazítja a cookie Secure
# flagjét (HTTP-n is megy a refresh cookie). Prod-ban hagyjuk üresen vagy
# explicit "production"-re.
APP_ENV=local

# Alkalmazás-titok a Token HMAC-hez (activation / remember-me / password-reset
# hash-ek). Generálás: `openssl rand -hex 32`. Csak akkor van használva, ha az
# Application/application.json-ban nincs application.secretKey (config-less
# deploy-okra). NE módosítsd futó rendszeren, mert minden tárolt hash invalid lesz.
APP_SECRET_KEY=

# Az SPA verify-email page URL-je. A backend a register-emailbe és (dev-flag-gel)
# a register response `verification_link` mezőjébe ezt rakja `?token=…` query-vel.
# Külön-origin SPA: http://localhost:5173/verify-email, embedded: /verify-email.
APP_VERIFY_EMAIL_URL=http://localhost:5173/verify-email

# Dev-only kényelmi flag: ha `1`, a `POST /api/v1/auth/register` response body-ja
# tartalmazza a `verification_link`-et — így SMTP nélkül is végigvihető a flow.
# Production-ben HAGYD ÜRESEN / 0-n, különben a link megjelenik az API-on.
APP_EXPOSE_VERIFICATION_LINK=0

# SPA deploy-mód:
#   separate  — a SPA külön origin-en (pl. http://localhost:5173 Vite dev), backend csak API. CORS allow-list aktív.
#   embedded  — a buildelt SPA-t a src/html/app/ alá másolva, egy origin. CORS off.
#   both      — fejlesztéshez (mindkettő egyszerre).
APP_SPA_MODE=separate

# --- M5: production hardening ---

# Strukturált JSON log a stdout-ra. Csatorna + szint env-ből.
# Szint: DEBUG | INFO | NOTICE | WARNING | ERROR | CRITICAL | ALERT | EMERGENCY
APP_LOG_CHANNEL=app
APP_LOG_LEVEL=INFO

# Security headers (Framework\Http\SecurityHeadersMiddleware). A defaultok
# általában jók; CSP-t SPA-host-spec szerint érdemes szélesíteni.
# APP_CSP="default-src 'self'; img-src 'self' data:; ..."
# APP_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
# APP_HSTS_MAX_AGE=31536000
# APP_HSTS_PRELOAD=0

# TLS-terminating reverse proxy mögött kapcsold be: ezzel a backend
# honorálja az X-Forwarded-Proto / X-Forwarded-For header-eket. Egységes
# kapcsoló a SecurityHeaders, HttpsRedirect és RateLimit middleware-ekhez.
APP_TRUST_PROXY=0

# HTTPS-redirect: 301 plain HTTP → HTTPS. Production-ben kapcsold be.
# `APP_TRUST_PROXY=1` is kell, ha TLS-terminating proxy van előtte
# (különben végtelen loop). A /api/v1/healthz és /api/v1/readyz mindig
# kivétel a redirektből.
APP_FORCE_HTTPS=0

# Rate-limit backend. `memory` = process-local (dev/single-worker SAPI);
# `redis` = osztott bucket, multi-worker FPM/k8s deployhez kötelező.
APP_RATE_LIMIT=0
APP_RATE_LIMIT_BACKEND=memory
REDIS_DSN=tcp://127.0.0.1:6379
REDIS_KEY_PREFIX=rl:
